project:
  name: pixel-virtual-pet
  generated: 2026-11-08
  total_files: 42

files:
  lib/pet.ts:
    role: Mendefinisikan model data monster, konstanta batasan status 0-100, sprite default 32x32, serta fungsi murni perawatan dan time decay.
    exports: [PET_DATA_VERSION, GRID_SIZE, STAT_MIN, STAT_MAX, MAX_OFFLINE_MS, PetData, PetReaction, CareActionResult, MiniGameResult, clampStat, createEmptyPixels, clonePixels, isValidHexColor, normalizePixels, countPaintedPixels, hasPaintedPixels, createDefaultPixels, sanitizePetName, createDefaultPet, applyTimeDecay, feedPet, playWithPet, sleepPet, applyMiniGameReward, getPetMood, getHungerLabel, getHappinessLabel, getEnergyLabel]
    depends_on: []
    key_functions:
      - name: clampStat
        does: Membatasi nilai status secara ketat pada rentang 0 hingga 100.
      - name: applyTimeDecay
        does: Mengurangi lapar, bahagia, dan energi berdasarkan selisih waktu dengan batas maksimal 2 jam offline.
      - name: feedPet
        does: Menambah status kenyang (+25) dan bahagia (+5) pada monster.
      - name: playWithPet
        does: Menambah kebahagiaan (+20) dan mengurangi energi (-15) jika energi minimal 10.
      - name: sleepPet
        does: Memulihkan status energi monster (+35) hingga batas maksimal 100.
      - name: applyMiniGameReward
        does: Memperbarui highScore dan menambah status monster berdasarkan hasil mini-game.

  lib/storage.ts:
    role: Menangani serialisasi, persistensi, migrasi versi, dan pembacaan data monster pada localStorage browser.
    exports: [PET_STORAGE_KEY, migratePetData, savePetData, loadPetData, resetPetData]
    depends_on: [lib/pet.ts]
    key_functions:
      - name: loadPetData
        does: Membaca data monster dari localStorage, memigrasi versi, menerapkan time decay, atau membuat data default jika kosong/korup.
      - name: savePetData
        does: Menyimpan objek PetData ke localStorage dalam format JSON.
      - name: resetPetData
        does: Menimpa penyimpanan dengan data monster default dan menyimpannya.
    notes: Mengabaikan pemanggilan jika berjalan di sisi server (SSR).

  lib/device.ts:
    role: Menghasilkan dan menyimpan identifier unik per browser untuk penghitungan peer pada server sinkronisasi.
    exports: [getDeviceId]
    depends_on: []
    notes: Identifier disimpan di localStorage; fallback string acak jika crypto.randomUUID tidak tersedia.

  lib/lanSync.ts:
    role: Client sync manager yang mendaftarkan pet device ke server dan mengambil daftar pet device lain yang online di jaringan yang sama.
    exports: [LanSyncStatus, LanNeighborEntry, LAN_SYNC_POLL_MS, LAN_RE_PUSH_MS, LAN_MAX_FAILURES, queueLanPush, startLanSync, stopLanSync]
    depends_on: [lib/pet.ts, lib/device.ts]
    key_functions:
      - name: startLanSync
        does: Menjalankan loop polling tiap 3 detik; meneruskan status koneksi dan daftar neighbor dari server, mendorong perubahan pet lokal, dan mengirim ulang pendaftaran tiap 60 detik agar pet tetap terdaftar walau server restart.
      - name: queueLanPush
        does: Mengantre push pet lokal dengan debounce 800 ms setelah aksi perubahan data.
    notes: Pet device sendiri tidak pernah ditarik dari server (localStorage tetap sumber utama); status offline baru dilaporkan setelah LAN_MAX_FAILURES (3) polling gagal berurutan — satu flap jaringan tidak mengubah indikator.

  lib/duel.ts:
    role: Konstanta dan tipe data bersama untuk duel antar device (dipakai route server, client, dan test).
    exports: [DUEL_MAX_HP, DUEL_DAMAGE, DUEL_CHARGE_NEEDED, DUEL_ROUND_MS, DUEL_PENDING_EXPIRY_MS, DUEL_FINISHED_RETENTION_MS, DuelPlayer, DuelEvent, Duel]
    depends_on: []

  lib/duelSync.ts:
    role: Client API dan polling state duel antar device ke route /api/duel.
    exports: [DUEL_POLL_MS, DUEL_MISS_TOLERANCE, DuelPlayerView, DuelEventView, DuelView, DuelSnapshot, challengePet, respondDuel, submitDuelAnswer, startDuelSync]
    depends_on: [lib/device.ts]
    key_functions:
      - name: startDuelSync
        does: Polling tiap 1,5 detik; hanya memanggil onSnapshot saat JSON respons berubah agar tidak memicu render berulang.
      - name: challengePet
        does: Mengirim tantangan duel beserta nama monster pengirim dan target.
    notes: Hysteresis DUEL_MISS_TOLERANCE (3): snapshot kosong setelah duel aktif ditahan dulu sebelum diteruskan, supaya request yang mendarat di instance server tanpa state duel (umum di serverless) tidak memicu redirect liar; fetch gagal tidak pernah mengosongkan duel.

  app/api/pet/route.ts:
    role: Route handler Next.js sebagai server sinkronisasi LAN; menyimpan pet milik tiap device terpisah dan mendaftarkan device yang sedang online agar bisa saling terlihat.
    exports: [GET, POST]
    depends_on: [lib/pet.ts, lib/storage.ts]
    key_functions:
      - name: GET
        does: Mengembalikan daftar pet beserta deviceId pemiliknya untuk device yang aktif 30 detik terakhir, plus jumlah peer; mencatat heartbeat deviceId dari query string.
      - name: POST
        does: Memvalidasi body via migratePetData dan menyimpan pet ke registri milik deviceId pengirim dengan aturan last-write-wins per device berbasis updatedAt, lalu menulis persistensi ke file .data/pet-sync.json.
    notes: State disimpan di globalThis agar tahan HMR dev; peer dianggap aktif bila heartbeat dalam 10 detik terakhir.

  app/api/duel/route.ts:
    role: Route handler Next.js sebagai server duel antar device; mengelola tantangan, respons terima/tolak, ronde pertanyaan huruf per pemain, progres daya serangan (streak), dan resolusi projektil.
    exports: [GET, POST]
    depends_on: [lib/letters.ts, lib/duel.ts]
    key_functions:
      - name: resolveRound
        does: Menutup ronde saat kedua pemain menjawab atau timeout; setiap pemain dinilai terhadap perintah hurufnya sendiri (commands[0] != commands[1]); jawaban benar menambah streak (penuh = 3 -> jawaban benar berikutnya meluncurkan projektil dan streak reset ke 0), salah mengurangi streak satu; dua projektil di ronde sama bertabrakan (collision, tanpa damage), satu projektil mengenai lawan (-20 HP) hingga HP 0 menandai pemenang.
      - name: findRelevantDuel
        does: Memilih duel untuk sebuah device dengan prioritas aktif > pending > hasil akhir terbaru, supaya duel lama yang masih disimpan tidak menaungi duel yang sedang berjalan.
      - name: POST action challenge
        does: Membuat duel pending; menolak bila salah satu device sudah punya duel pending/active.
      - name: POST action respond
        does: Target menerima (duel jadi active, ronde 1 dengan sepasang perintah huruf acak yang berbeda + batas waktu) atau menolak (status declined).
    notes: State duel disimpan di globalThis (tahan HMR) dan dipersisten best-effort ke .data/duel-sync.json agar instance baru/restart bisa melanjutkan duel yang sedang berjalan; duel pending kedaluwarsa 30 detik dan hasil akhir disimpan 60 detik; resolusi ronde bersifat lazy saat GET/POST; respons GET tidak memuat timestamp agar polling client bisa mendeteksi perubahan dengan andal.

  lib/letters.ts:
    role: Mengelola daftar huruf A-Z, konfigurasi ronde mini-game, tingkat kesulitan, dan utilitas pengacakan opsi huruf.
    exports: [LETTERS, Letter, TOTAL_ROUNDS, MAX_LIVES, POINTS_PER_CORRECT, GameDifficulty, DifficultySettings, DIFFICULTY_CONFIG, LetterRound, getLetterAudioPath, shuffleArray, generateRound, isValidLetterOption]
    depends_on: []
    key_functions:
      - name: generateRound
        does: Menghasilkan 1 huruf target dan 3 huruf pengecoh unik serta mengacak posisi urutannya.
      - name: isValidLetterOption
        does: Memeriksa apakah input huruf termasuk dalam 4 pilihan huruf yang valid pada ronde aktif.

  store/useDuelStore.ts:
    role: Store Zustand untuk state duel antar device; tantangan masuk, duel aktif/hasil, pemberitahuan penolakan, dan pemberitahuan duel terputus.
    exports: [DuelChallenge, DuelDeclinedNotice, DuelAbandonedNotice, useDuelStore]
    depends_on: [lib/duelSync.ts]
    key_functions:
      - name: applySnapshot
        does: Menerjemahkan snapshot polling menjadi state store; status declined hanya diberitahukan ke penantang (players[0]); hasil akhir (finished) dipertahankan walau server sudah membersihkan duel; duel aktif yang hilang (post-hysteresis) menghasilkan notice abandoned dengan pesan jelas.
    notes: firstSyncDone menandai snapshot pertama selesai diproses — redirect halaman hanya boleh terjadi setelah itu, supaya refresh di tengah duel tidak langsung menendang pengguna ke Beranda.

  store/usePetStore.ts:
    role: Store Zustand global yang mengatur sinkronisasi state monster dan status mini-game antara React dan Phaser, serta status sinkronisasi LAN dan daftar monster tetangga.
    exports: [MiniGameState, MiniGameFeedback, MiniGameRewardSummary, LanSyncStatus, LanNeighbor, usePetStore]
    depends_on: [lib/letters.ts, lib/pet.ts, lib/storage.ts, lib/lanSync.ts]
    key_functions:
      - name: hydrate
        does: Memuat data monster dari localStorage ke dalam store saat komponen klien pertama kali dimuat.
      - name: updatePixels
        does: Memvalidasi dan menyimpan matriks pixel monster baru jika tidak kosong.
      - name: completeMiniGame
        does: Menerapkan hadiah mini-game ke status monster, menyimpan ke localStorage, dan mengubah gameState ke selesai.
      - name: setLanStatus
        does: Mencatat status koneksi sinkronisasi (connecting/online/offline) dan jumlah peer aktif.
      - name: setLanNeighbors
        does: Menyimpan daftar monster milik device lain yang sedang online beserta ringkasan kondisinya.
    notes: Bertindak sebagai single source of truth untuk antarmuka React dan scene Phaser; pet sendiri tidak pernah ditimpa data dari device lain; setiap aksi lokal yang mengubah pet memanggil queueLanPush.

  game/soundFx.ts:
    role: Penghasil efek suara retro chiptune 8-bit sintetis secara programatis menggunakan Web Audio API browser.
    exports: [playClickSfx, playCorrectSfx, playWrongSfx, playWinSfx, playLoseSfx]
    depends_on: []
    key_functions:
      - name: playTone
        does: Membuat osilator WebAudio dengan amplop modulasi gain untuk menghasilkan nada sintetis.
      - name: playCorrectSfx
        does: Memutar melodi arpeggio nada naik untuk menandai jawaban benar.
      - name: playWrongSfx
        does: Memutar nada rendah menurun untuk menandai jawaban salah atau jatuh.
    notes: Menggunakan instance AudioContext bersama yang dibuka saat ada interaksi pengguna.

  game/petAnimations.ts:
    role: Mengonversi matriks pixel monster menjadi tekstur Phaser nearest-neighbor dan menjalankan tween animasi programatis.
    exports: [PET_TEXTURE_KEY, PET_DISPLAY_SCALE, buildPetTexture, playIdleAnimation, playListeningAnimation, playRunAnimation, playFallAnimation, playWinAnimation, playSadAnimation]
    depends_on: [lib/pet.ts]
    key_functions:
      - name: buildPetTexture
        does: Menggambar matriks 32x32 ke canvas dan mendaftarkannya sebagai tekstur Phaser berfilter nearest-neighbor.
      - name: playRunAnimation
        does: Menggerakkan sprite monster maju miring berulang dengan partikel debu saat jawaban benar.
      - name: playFallAnimation
        does: Menjalankan animasi rotasi jatuh, guncangan kamera, dan efek benturan saat jawaban salah.

  game/scenes/MiniGameScene.ts:
    role: Scene utama Phaser yang mengelola state machine mini-game suara, pemutaran audio huruf, input keyboard, dan feedback visual.
    exports: [SCENE_KEY, MiniGameScene]
    depends_on: [lib/letters.ts, store/usePetStore.ts, game/petAnimations.ts, game/soundFx.ts]
    key_functions:
      - name: preload
        does: Memuat seluruh file audio huruf lokal A-Z ke dalam cache Phaser.
      - name: beginRound
        does: Menyiapkan ronde baru, memutar suara instruksi target huruf, dan mengubah state ke MEMUTAR_SUARA.
      - name: handleAnswer
        does: Memvalidasi input jawaban pemain, memicu animasi lari/jatuh, memperbarui skor/nyawa, dan memblokir input ganda.
      - name: cleanupAudioAndTimers
        does: Menghentikan audio aktif dan membatalkan seluruh timer saat scene ditutup atau di-reset.
    notes: Berkomunikasi dua arah dengan React melalui event emitter game Phaser dan Zustand store.

  game/createGame.ts:
    role: Factory pembantu untuk menginisialisasi instance Phaser Game di elemen DOM container dengan konfigurasi pixelArt.
    exports: [MiniGameController, createGame]
    depends_on: [game/scenes/MiniGameScene.ts]
    key_functions:
      - name: createGame
        does: Menginstansiasi Phaser.Game dengan resolusi kanvas 640x320 dan mengembalikan kontroller event.

  components/StoreHydrator.tsx:
    role: Komponen utilitas klien untuk memicu hidrasi data dari localStorage, sinkronisasi berkala time decay, dan menjalankan loop sinkronisasi LAN.
    exports: [StoreHydrator]
    depends_on: [store/usePetStore.ts, lib/lanSync.ts, lib/device.ts, lib/pet.ts]
    notes: Memasang interval 30 detik, event listener visibilitychange, dan startLanSync yang dihentikan bersih saat unmount; menyaring pet milik sendiri dari daftar neighbor dan menghitung mood tiap tetangga.

  components/NavBar.tsx:
    role: Bilah navigasi atas yang menampilkan nama monster aktif, indikator status sinkronisasi LAN (jumlah perangkat terhubung), dan link ke halaman Beranda, Rawat, Gambar, dan Mini-Game.
    exports: [NavBar]
    depends_on: [store/usePetStore.ts, components/PetSprite.tsx]

  components/PetSprite.tsx:
    role: Komponen React untuk merender sprite pixel 32x32 secara tajam menggunakan HTML5 Canvas dan animasi CSS.
    exports: [PetSprite]
    depends_on: [lib/pet.ts]
    notes: Mendukung mode animasi CSS bernapas, makan, bermain, tidur, senang, dan sedih.

  components/PetStatus.tsx:
    role: Menampilkan kartu indikator status Lapar, Bahagia, Energi (0-100), label kondisi monster, dan skor rekor tertinggi.
    exports: [PetStatus]
    depends_on: [lib/pet.ts]

  components/PetActions.tsx:
    role: Menampilkan tombol interaksi perawatan monster (Beri Makan, Ajak Bermain, Tidur/Istirahat) beserta pesan umpan balik.
    exports: [PetActions]
    depends_on: [store/usePetStore.ts]

  components/PixelEditor.tsx:
    role: Editor pixel 32x32 interaktif dengan pensil, penghapus, flood fill, pengambil warna, undo/redo, dan pratinjau monster.
    exports: [PixelEditor]
    depends_on: [lib/pet.ts, store/usePetStore.ts, components/PetSprite.tsx]
    key_functions:
      - name: floodFill
        does: Menjalankan algoritma BFS untuk mengisi bidang warna contiguous pada kanvas 32x32.
      - name: handleSave
        does: Memvalidasi kanvas tidak kosong sebelum menyimpan matriks pixel monster ke store.
    notes: Menggunakan pointer capture dan interpolasi garis Bresenham agar goresan sentuh/mouse mulus tanpa putus.

  components/NeighborPets.tsx:
    role: Panel daftar monster milik device lain yang sedang online di jaringan yang sama, dengan sprite, nama, kondisi, dan tombol untuk mengajak duel tiap monster.
    exports: [NeighborPets]
    depends_on: [store/usePetStore.ts, components/PetSprite.tsx, lib/duelSync.ts, lib/pet.ts]

  components/NeighborWanderers.tsx:
    role: Renderer monster tetangga yang berkeliaran di panggung ruang perawatan; setiap monster berpindah posisi acak dengan transisi halus, animasi jalan, arah menghadap, label nama, dan bisa diklik untuk mengajak duel.
    exports: [NeighborWanderers]
    depends_on: [store/usePetStore.ts, components/PetSprite.tsx, lib/duelSync.ts]
    notes: Dibatasi maksimal 6 pengembara; klik membuka menu kecil "Ajak duel?" di atas panggung dan mengirim tantangan via challengePet.

  components/StagePet.tsx:
    role: Monster utama di panggung ruang perawatan; berjalan-jalan sendiri ke posisi acak, bisa di-drag and drop oleh pengguna ke mana saja di area panggung, dan tetap menampilkan animasi reaksi aksi perawatan saat sedang aktif.
    exports: [StagePet]
    depends_on: [store/usePetStore.ts, components/PetSprite.tsx, lib/pet.ts]
    key_functions:
      - name: handlePointerDown/Move/Up
        does: Menangkap pointer (mouse & sentuh) untuk menyeret monster di dalam elemen [data-stage], mengikuti posisi pointer dalam persen area panggung dengan batas tepi.
    notes: Wandering dijeda saat drag atau saat reaction store tidak idle; arah sprite menyesuaikan arah gerakan.

  components/GameCanvas.tsx:
    role: Pembungkus React untuk memuat kanvas Phaser secara dinamis di sisi klien dan mengelola siklus hidup instance Phaser.
    exports: [GameCanvas]
    depends_on: [game/createGame.ts, store/usePetStore.ts]
    notes: Memanggil controller.destroy() secara bersih saat komponen unmount untuk mencegah memory leak.

  components/LetterButtons.tsx:
    role: Menampilkan 4 tombol pilihan huruf besar yang responsif terhadap klik layar sentuh dan keyboard fisik.
    exports: [LetterButtons]
    depends_on: [store/usePetStore.ts]
    notes: Tombol dinonaktifkan otomatis saat status permainan bukan MENUNGGU_JAWABAN.

  components/DuelManager.tsx:
    role: Komponen global di layout untuk sinkronisasi duel; polling state, popup tantangan masuk (terima/tolak), popup penolakan, popup duel terputus, dan navigasi satu arah (URL mengikuti state duel) yang baru aktif setelah sync pertama selesai.
    exports: [DuelManager]
    depends_on: [lib/device.ts, lib/duelSync.ts, store/useDuelStore.ts]

  app/duel/page.tsx:
    role: Arena duel dua pemain; menampilkan HP dan daya serangan kedua monster, instruksi huruf bersuara, pilihan jawaban layar + keyboard, hitung mundur ronde, animasi projektil (terbang, tabrakan, kena), layar hasil akhir, dan layar loading saat state duel pertama kali disinkronkan (aman saat refresh di tengah duel).
    exports: [default]
    depends_on: [components/PetSprite.tsx, lib/device.ts, lib/duelSync.ts, lib/letters.ts, lib/pet.ts, store/useDuelStore.ts, store/usePetStore.ts]
    key_functions:
      - name: submit
        does: Mengirim jawaban huruf sekali per ronde via submitDuelAnswer, dengan pengaman dobel dari state answered server.
    notes: Animasi projektil memakai keyframes duelFlyRight/duelFlyLeft/duelFlyCenterR/duelFlyCenterL/duelPop di globals.css; sprite lawan diambil dari daftar lanNeighbors berdasarkan deviceId.

  app/layout.tsx:
    role: Layout utama aplikasi Next.js yang memuat metadata, stylesheet global, StoreHydrator, DuelManager, dan NavBar.
    exports: [metadata, default]
    depends_on: [components/NavBar.tsx, components/StoreHydrator.tsx, components/DuelManager.tsx]

  app/page.tsx:
    role: Halaman beranda yang menampilkan hero monster aktif, ringkasan status, panduan alur game, daftar monster tetangga yang online, dan tombol reset data lokal.
    exports: [default]
    depends_on: [components/NeighborPets.tsx, components/PetSprite.tsx, components/PetStatus.tsx, lib/pet.ts, store/usePetStore.ts]

  app/pet/page.tsx:
    role: Halaman ruang perawatan monster untuk mengubah nama monster, panggung dengan monster utama yang bisa di-drag dan berjalan-jalan bersama monster tetangga, status, aksi perawatan, dan daftar monster tetangga yang online.
    exports: [default]
    depends_on: [components/PetActions.tsx, components/NeighborPets.tsx, components/NeighborWanderers.tsx, components/StagePet.tsx, components/PetStatus.tsx, lib/pet.ts, store/usePetStore.ts]

  app/pet/draw/page.tsx:
    role: Halaman rute editor pixel monster yang merender komponen PixelEditor dan tautan kembali ke perawatan.
    exports: [default]
    depends_on: [components/PixelEditor.tsx]

  app/play/page.tsx:
    role: Halaman arena mini-game suara yang memuat HUD ronde/skor/nyawa, GameCanvas dinamis, opsi aksesibilitas, dan LetterButtons.
    exports: [default]
    depends_on: [components/LetterButtons.tsx, game/createGame.ts, lib/letters.ts, store/usePetStore.ts, components/GameCanvas.tsx]

  tests/pet.test.ts:
    role: Pengujian unit untuk logika model data pet, pembatasan nilai status 0-100, aksi perawatan, dan batas offline time decay.
    exports: []
    depends_on: [lib/pet.ts]

  tests/letters.test.ts:
    role: Pengujian unit untuk generator ronde huruf acak, validasi 4 pilihan unik, dan kemunculan tepat satu target.
    exports: []
    depends_on: [lib/letters.ts]

  tests/storage.test.ts:
    role: Pengujian unit untuk penyimpanan dan pembacaan localStorage, toleransi JSON rusak, serta validasi kanvas kosong.
    exports: []
    depends_on: [lib/pet.ts, lib/storage.ts, store/usePetStore.ts]

  tests/syncRoute.test.ts:
    role: Pengujian unit route /api/pet; penyimpanan pet per device, visibilitas antar device, aturan last-write-wins per device, normalisasi status, dan validasi body.
    exports: []
    depends_on: [app/api/pet/route.ts, lib/pet.ts]

  tests/lanSync.test.ts:
    role: Pengujian unit client sync manager; penerusan daftar neighbor, push pet lokal, debounce push, status offline, dan tidak mengirim ulang data yang sudah terkirim.
    exports: []
    depends_on: [lib/lanSync.ts, lib/pet.ts]

  tests/duelRoute.test.ts:
    role: Pengujian unit route /api/duel; alur tantangan/respons, aturan streak (benar +1, salah -1, ke-4 meluncurkan projektil), tabrakan projektil, kemenangan, otorisasi pemain, timeout ronde, dan pemulihan duel aktif dari persistensi disk.
    exports: []
    depends_on: [app/api/duel/route.ts, lib/duel.ts]

  tests/duelSync.test.ts:
    role: Pengujian unit hysteresis polling duel; snapshot kosong ditahan 3x setelah duel aktif, incoming diteruskan langsung, dan streak kosong ter-reset saat duel muncul kembali.
    exports: []
    depends_on: [lib/duelSync.ts]

  tests/duelStore.test.ts:
    role: Pengujian unit store duel; firstSyncDone, notice abandoned saat duel aktif hilang, dan hasil finished yang dipertahankan.
    exports: []
    depends_on: [store/useDuelStore.ts, lib/duelSync.ts]

edges:
  - from: app/api/duel/route.ts
    to: lib/letters.ts
    via: import LETTERS untuk perintah huruf acak
  - from: app/api/duel/route.ts
    to: lib/duel.ts
    via: import konstanta duel dan tipe Duel/DuelEvent
  - from: lib/storage.ts
    to: lib/pet.ts
    via: import fungsi createDefaultPet, applyTimeDecay, clampStat, normalizePixels, sanitizePetName
  - from: store/usePetStore.ts
    to: lib/pet.ts
    via: import model PetData, feedPet, playWithPet, sleepPet, applyMiniGameReward
  - from: store/usePetStore.ts
    to: lib/storage.ts
    via: import loadPetData, savePetData, resetPetData
  - from: store/usePetStore.ts
    to: lib/lanSync.ts
    via: import queueLanPush untuk push perubahan pet lokal ke server sinkronisasi
  - from: store/usePetStore.ts
    to: lib/letters.ts
    via: import GameDifficulty, MAX_LIVES
  - from: game/petAnimations.ts
    to: lib/pet.ts
    via: import GRID_SIZE
  - from: game/scenes/MiniGameScene.ts
    to: lib/letters.ts
    via: import LETTERS, generateRound, getLetterAudioPath, isValidLetterOption
  - from: game/scenes/MiniGameScene.ts
    to: store/usePetStore.ts
    via: import usePetStore
  - from: game/scenes/MiniGameScene.ts
    to: game/petAnimations.ts
    via: import buildPetTexture, playIdleAnimation, playRunAnimation, playFallAnimation
  - from: game/scenes/MiniGameScene.ts
    to: game/soundFx.ts
    via: import fungsi audio SFX
  - from: game/createGame.ts
    to: game/scenes/MiniGameScene.ts
    via: import MiniGameScene
